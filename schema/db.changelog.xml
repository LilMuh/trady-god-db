<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 所有 changeset 都写在这个文件中。 -->
    <!-- changeset id 的格式：YYYY-MMDD-描述。 -->
    <!-- 警告：不要修改已经执行过的 changeset。要改表结构，在文件末尾追加新的 changeset。 -->

    <changeSet id="2026-0306-market data table creation" author="lilfist">
        <createTable tableName="market_data">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pair" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="interval" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <column name="open_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="close_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="open_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="high_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="low_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="close_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="volume" type="NUMERIC(28, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="is_completed" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>

        <createIndex indexName="idx_market_pair_time_interval" tableName="market_data" unique="true">
            <column name="pair"/>
            <column name="interval"/>
            <column name="open_time" descending="true"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-0307-orders-table-creation" author="lilfist">
        <createTable tableName="orders">
            <column name="exchange_order_id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pair" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="side" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE orders
            ADD CONSTRAINT chk_orders_side
            CHECK (side IN ('BUY', 'SELL'));
        </sql>

        <sql>
            ALTER TABLE orders
            ADD CONSTRAINT chk_orders_status
            CHECK (status IN ('FILLED', 'CANCELED'));
        </sql>

        <createIndex indexName="idx_orders_pair_status" tableName="orders">
            <column name="pair"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- orders 表增加永续合约订单的字段。 -->
    <!-- 新字段全部允许为空，旧的现货订单记录不受影响。 -->
    <!-- 对合约订单，amount 是成交张数，price 是成交均价。没有成交时两者都是 0。 -->
    <changeSet id="2026-1030-orders-swap-columns" author="lilfist">
        <addColumn tableName="orders">
            <!-- 持仓方向：long 或 short。 -->
            <column name="pos_side" type="VARCHAR(10)"/>
            <!-- 保证金模式，例如 isolated。 -->
            <column name="td_mode" type="VARCHAR(10)"/>
            <!-- 订单类型，例如 limit 或 market。 -->
            <column name="ord_type" type="VARCHAR(20)"/>
            <!-- 挂单价。市价单为空。 -->
            <column name="order_price" type="NUMERIC(20, 8)"/>
            <!-- 下单张数。 -->
            <column name="order_size" type="NUMERIC(20, 8)"/>
            <!-- 杠杆倍数。 -->
            <column name="lever" type="NUMERIC(10, 2)"/>
            <!-- 手续费。负数表示支付。 -->
            <column name="fee" type="NUMERIC(20, 8)"/>
            <!-- 平仓收益。 -->
            <column name="pnl" type="NUMERIC(20, 8)"/>
            <!-- 触发这个平仓单的止盈止损单编号。开仓单为空。 -->
            <column name="algo_id" type="VARCHAR(100)"/>
            <!-- 交易所下单时间，单位毫秒。 -->
            <column name="order_time" type="BIGINT"/>
            <!-- 写入数据库的时间。 -->
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </addColumn>
    </changeSet>

    <!-- 新增交易记录表 trades。 -->
    <!-- 一行是一笔交易：从开仓挂单开始，到撤单或平仓结束。 -->
    <!-- 实盘写这个表。回测不写这个表，只用相同的字段。 -->
    <changeSet id="2026-1031-trades-table-creation" author="lilfist">
        <createTable tableName="trades">
            <!-- 主键。 -->
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- 交易环境：demo（模拟盘）或 live（实盘）。取自 OKX_ENV。 -->
            <column name="environment" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <!-- 交易对，例如 BTC-USDT-SWAP。 -->
            <column name="pair" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!-- K 线周期，例如 15m。 -->
            <column name="interval" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <!-- 策略名称。 -->
            <column name="strategy" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <!-- 持仓方向：long 或 short。 -->
            <column name="direction" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <!-- 信号 K 线的开盘时间，单位毫秒。 -->
            <column name="signal_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- 信号名称，例如"大阳线"。 -->
            <column name="signal_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <!-- 信号的附加说明。可以为空。 -->
            <column name="signal_note" type="VARCHAR(200)"/>
            <!-- 挂单价。这个值已经取整。 -->
            <column name="entry_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <!-- 止损价。这个值已经取整。 -->
            <column name="stop_loss_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <!-- 止盈价。这个值已经取整。 -->
            <column name="take_profit_price" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <!-- 下单张数。 -->
            <column name="contracts" type="NUMERIC(20, 8)">
                <constraints nullable="false"/>
            </column>
            <!-- 开仓挂单的订单号。每个订单号只能出现一次。 -->
            <column name="entry_order_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <!-- 交易状态：PENDING、CANCELED、OPEN 或 CLOSED。 -->
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!-- 撤单原因：EXPIRED（没有成交）、REPLACED（有新信号）或 OTHER。 -->
            <!-- OPEN 和 CLOSED 的行也可以有值，表示部分成交后撤掉了剩余部分。 -->
            <column name="cancel_reason" type="VARCHAR(20)"/>
            <!-- 成交时间，单位毫秒。 -->
            <column name="open_time" type="BIGINT"/>
            <!-- 成交均价。 -->
            <column name="open_price" type="NUMERIC(20, 8)"/>
            <!-- 成交张数。 -->
            <column name="filled_contracts" type="NUMERIC(20, 8)"/>
            <!-- 平仓时间，单位毫秒。 -->
            <column name="close_time" type="BIGINT"/>
            <!-- 平仓均价。 -->
            <column name="close_price" type="NUMERIC(20, 8)"/>
            <!-- 平仓原因：TAKE_PROFIT、STOP_LOSS 或 OTHER。 -->
            <column name="close_reason" type="VARCHAR(20)"/>
            <!-- 开仓手续费。正数表示支付。 -->
            <column name="open_fee" type="NUMERIC(20, 8)"/>
            <!-- 平仓手续费。正数表示支付。 -->
            <column name="close_fee" type="NUMERIC(20, 8)"/>
            <!-- 持仓期间的资金费合计。正数表示支付。回测的值是 0。 -->
            <column name="funding_fee" type="NUMERIC(20, 8)" defaultValueNumeric="0"/>
            <!-- 盈亏，已经扣除手续费和资金费。 -->
            <!-- pnl = 价差盈亏 - open_fee - close_fee - funding_fee。 -->
            <column name="pnl" type="NUMERIC(20, 8)"/>
            <!-- 同一根 K 线碰到止盈价和止损价时为 true，这笔交易按止损计算。只有回测会是 true。 -->
            <column name="same_candle_stop_loss" type="BOOLEAN" defaultValueBoolean="false"/>
            <!-- 写入数据库的时间。 -->
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
            <!-- 最后更新的时间。 -->
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>

        <sql>
            ALTER TABLE trades
            ADD CONSTRAINT chk_trades_environment
            CHECK (environment IN ('demo', 'live'));
        </sql>

        <sql>
            ALTER TABLE trades
            ADD CONSTRAINT chk_trades_direction
            CHECK (direction IN ('long', 'short'));
        </sql>

        <sql>
            ALTER TABLE trades
            ADD CONSTRAINT chk_trades_status
            CHECK (status IN ('PENDING', 'CANCELED', 'OPEN', 'CLOSED'));
        </sql>

        <sql>
            ALTER TABLE trades
            ADD CONSTRAINT chk_trades_cancel_reason
            CHECK (cancel_reason IS NULL OR cancel_reason IN ('EXPIRED', 'REPLACED', 'OTHER'));
        </sql>

        <sql>
            ALTER TABLE trades
            ADD CONSTRAINT chk_trades_close_reason
            CHECK (close_reason IS NULL OR close_reason IN ('TAKE_PROFIT', 'STOP_LOSS', 'OTHER'));
        </sql>

        <!-- status 是 CANCELED 时，cancel_reason 不能为空。 -->
        <sql>
            ALTER TABLE trades
            ADD CONSTRAINT chk_trades_canceled_has_reason
            CHECK (status &lt;&gt; 'CANCELED' OR cancel_reason IS NOT NULL);
        </sql>

        <createIndex indexName="idx_trades_environment_pair_status" tableName="trades">
            <column name="environment"/>
            <column name="pair"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
