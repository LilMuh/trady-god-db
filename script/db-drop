#!/bin/bash
# 删除全部表，包括 Liquibase 的记录表。
# 警告：这个操作删除全部数据。执行前要求输入 y 确认。

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# 读取 .env 中的连接信息。
source "$PROJECT_DIR/.env"

cd "$PROJECT_DIR"

echo "===== 删除数据库 ====="
echo "Database: $LIQUIBASE_DATABASE_URL"
echo ""
echo "⚠️  警告：将删除数据库中的所有表！"
read -p "确认删除？(y/n): " confirm
if [ "$confirm" != "y" ]; then
    echo "操作已取消"
    exit 1
fi

./script/liquibase-wrapper dropAll

echo ""
echo "✓ 数据库已删除"
