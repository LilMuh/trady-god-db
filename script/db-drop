#!/bin/bash
# 删除数据库 - 删除所有表和 Liquibase 元数据表

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# 加载环境变量
source "$PROJECT_DIR/.env"

cd "$PROJECT_DIR"

echo "===== 删除数据库 ====="
echo "Database: $LIQUIBASE_DATABASE_URL"
echo ""
echo "⚠️  警告：将删除数据库中的所有表！"
read -p "确认删除？(y/n): " confirm
if [ "$confirm" != "y" ]; then
    echo "操作已取消"
    exit 1
fi

./script/liquibase-wrapper dropAll

echo ""
echo "✓ 数据库已删除"
