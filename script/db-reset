#!/bin/bash
# 先删除全部表，再执行全部 changeset。
# 警告：这个操作删除全部数据。

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

echo "===== 重置数据库 ====="
echo ""

# 删除全部表。用户取消时继续执行下一步。
"$PROJECT_DIR/script/db-drop" || true

# 执行全部 changeset。
"$PROJECT_DIR/script/db-create"

echo ""
echo "✓ 数据库重置完成"
